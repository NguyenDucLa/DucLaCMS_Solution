@model IEnumerable<CMS.Data.Entities.Post>

@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 text-danger">TIN TỨC MỚI NHẤT</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4"> <!-- Thêm mb-4 để các dòng không dính nhau -->
                <div class="card shadow-sm h-100">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" onerror="this.src='https://via.placeholder.com/300x200'">
                    <div class="card-body">
                        <span class="badge bg-primary mb-2">@(item.Category?.Name ?? "Chưa phân loại")</span>
                        <h5 class="card-title fw-bold">@item.Title</h5>
                        
                        <!-- DÒNG ĐÃ SỬA Ở ĐÂY -->
                        <div class="card-text text-truncate" style="max-height: 3rem;">
                            @Html.Raw(item.Content)
                        </div>
                        
                        <a href="/Post/Details/@item.Id" class="btn btn-outline-danger btn-sm mt-3">Đọc tiếp</a>
                    </div>
                    <div class="card-footer text-muted small">
                        Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>
        }
    </div>
</div>