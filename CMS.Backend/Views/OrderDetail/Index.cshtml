@model IEnumerable<CMS.Data.Entities.OrderDetail>

<div class="container mt-4">
    <h2 class="text-secondary fw-bold mb-4">CHI TIẾT CÁC MẶT HÀNG TRONG ĐƠN</h2>

    <table class="table table-sm table-hover border shadow-sm">
        <thead class="table-dark text-center">
            <tr>
                <th>Mã ĐH</th>
                <th>Sản phẩm</th>
                <th>Số lượng</th>
                <th>Đơn giá</th>
                <th>Thành tiền</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="align-middle">
                    <td class="text-center fw-bold text-primary">#@item.OrderId</td>
                    <td>
                        <div class="fw-bold">@item.Product?.Name</div>
                    </td>
                    <td class="text-center">@item.Quantity</td>
                    <td class="text-end">@string.Format("{0:N0}", item.UnitPrice) đ</td>
                    <td class="text-end fw-bold text-danger">
                        @string.Format("{0:N0}", item.Quantity * item.UnitPrice) đ
                    </td>
                </tr>
            }
        </tbody>
    </table>
    
    <div class="mt-3">
        <a href="/Order" class="btn btn-outline-secondary">Quay lại danh sách Đơn hàng</a>
    </div>
</div>