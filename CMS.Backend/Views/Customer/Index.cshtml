@model IEnumerable<CMS.Data.Entities.Customer>
@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold text-uppercase">Quản lý khách hàng</h2>
        <span class="badge bg-primary">Tổng số: @Model.Count()</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <table class="table table-hover table-bordered shadow-sm">
        <thead class="table-dark text-center">
            <tr>
                <th>ID</th>
                <th>Họ và tên</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Địa chỉ</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="align-middle">
                    <td class="text-center">@item.Id</td>
                    <td class="fw-bold">@item.FullName</td>
                    <td>
                        <a href="mailto:@item.Email" class="text-decoration-none">
                            <i class="fa-solid fa-envelope"></i> @item.Email
                        </a>
                    </td>
                    <td class="text-center">@item.Phone</td>
                    <td>@item.Address</td>
                    <td class="text-center">
                        <a asp-action="Orders" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-receipt"></i> Xem đơn
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                              onsubmit="return confirm('Xác nhận xóa khách hàng @item.FullName?');"
                              style="display:inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fa-solid fa-trash-can"></i> Xóa
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>