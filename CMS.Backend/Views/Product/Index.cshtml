@model IEnumerable<CMS.Data.Entities.Product>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Sản phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold border-bottom pb-2 mb-0">
            <i class="bi bi-box-seam"></i> DANH SÁCH SẢN PHẨM
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm sản phẩm
        </a>
    </div>

    <table class="table table-hover align-middle shadow-sm border">
        <thead class="table-primary text-center">
            <tr>
                <th>Ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th>Giá bán</th>
                <th>Kho</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="product" class="rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                        }
                        else
                        {
                            <span class="text-muted"><i class="bi bi-image" style="font-size: 1.5rem;"></i></span>
                        }
                    </td>
                    <td>
                        <div class="fw-bold">@item.Name</div>
                        <small class="text-muted">@item.Description</small>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-secondary">@(item.CategoryProduct?.Name ?? "N/A")</span>
                    </td>
                    <td class="text-danger fw-bold text-end">
                        @string.Format("{0:N0} VNĐ", item.Price)
                    </td>
                    <td class="text-center">
                        @if (item.StockQuantity > 0) {
                            <span class="badge bg-success">@item.StockQuantity</span>
                        } else {
                            <span class="badge bg-danger">Hết hàng</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm" role="group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning text-white" title="Sửa">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm @item.Name ?');">
                                <button type="submit" class="btn btn-danger" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>