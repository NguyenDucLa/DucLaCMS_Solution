@model IEnumerable<CMS.Data.Entities.Post>

<div class="container mt-4">
    <h2 class="mb-4 text-danger text-center text-uppercase fw-bold">Danh sách bài viết mới nhất</h2>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="row g-0">
                        <div class="col-md-4">
                            <img src="@item.ImageUrl" class="img-fluid rounded-start" alt="Thumbnail" style="height: 100%; object-fit: cover;">
                        </div>
                        <div class="col-md-8">
                            <div class="card-body">
                                <h5 class="card-title text-primary fw-bold">@item.Title</h5>
                                <p class="card-text text-muted" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @item.Content
                                </p>
                                <p class="card-text"><small class="text-muted">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</small></p>
                                <a href="#" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>