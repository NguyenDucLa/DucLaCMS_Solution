@model IEnumerable<CMS.Data.Entities.Order>
@{
    Layout = "_LayoutAdmin";
}

<div class="container mt-4">
    <h2 class="text-dark fw-bold mb-4">QUẢN LÝ ĐƠN HÀNG</h2>

    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-info text-center">
            <tr>
                <th>Mã ĐH</th>
                <th>Ngày đặt</th>
                <th>Khách hàng</th>
                <th>Trạng thái</th>
                <th>Ghi chú</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="align-middle">
                    <td class="text-center fw-bold">#@item.Id</td>
                    <td class="text-center">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Customer?.FullName</td>
                    <td class="text-center">
                        @if (item.Status == 0)
                        {
                            <span class="badge bg-warning text-dark">Chờ duyệt</span>
                        }
                        else if (item.Status == 1)
                        {
                            <span class="badge bg-primary">Đang giao</span>
                        }
                        else if (item.Status == 2)
                        {
                            <span class="badge bg-success">Đã xong</span>
                        }
                    </td>
                    <td class="small">@item.Notes</td>
                    <td class="text-center">
                        <a href="/Order/Details/@item.Id" class="btn btn-sm btn-dark">Xem chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>